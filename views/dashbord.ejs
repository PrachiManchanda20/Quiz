<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Learner Dashboard</title>
</head>
<body>
    <%- include('../partials/header') %>
    <h1>Welcome <%=username%></h1>
    <br/>
    <br/>
    <h2>Learner dashboard</h2>
    <div>
        <form method="get" action="/learner/dashboard">
    <select name="subjects">
        <option value="java" name="java">Java</option>
        <option value="javascript" name="javascript">Javascript</option>
        <option value="express"  name="express">Express</option>
    </select>
    <select name="difficulty">
        <option value="beginner" name="beginner">Beginner</option>
        <option value="intermediate" name="intermediate">Intermediate</option>
        <option value="advanced" name="advanced">Advanced</option>
    </select>
    <input type="submit" name="startQuiz" placeholder="Start Quizz">
    </form>

    </div>
    <%- include('../partials/footer') %>
   
</body>

</html>