<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quizz</title>
</head>

<body>
    <div id="login">
        <% if(typeof error !='undefined' && error){ %>
            <%= errorMsg %>
            <% } %>
    <form method="POST" action="/auth/login">
        <label for="name">Name:</label>
        <input type="text" id="name" placeholder="ENter your Name" name="username">
        <br /><br />

        <label for="Role">Role:</label>
        <!-- <input type="text" id="Role" placeholder="Learner/Admin"> -->
        <select name="role">
            <option value="learner">Learner</option>
            <option value="admin">Admin</option>
        </select>

        <br/><br />
       
        <label for="email">Email:</label>
        <input type="email" id="email" placeholder="Enter your Email" name="email" required>
        <br/><br />

        <label for="password">Password:</label>
        <input type="password" id="password" placeholder="Enter your Password" name="password" required>
        <br/><br />
        <br/>

        <input type="submit" placeholder="submit" is="submit"><br/><br/>
       <a href="/auth/changePass">Change Password</a>
        <br/><br/>

    </form>
    </div>
</body>

</html>