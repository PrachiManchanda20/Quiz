<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reset Password</title>
</head>
<body>
    <div id="resetPass">
        <% if(error) { %>
            <p><%= errorMsg %></p>
        <% } %>
    <% if(token) { %>
    <form method="POST" action="/auth/resetPass/<%= token %>"></form>
      <label for="forgot">New Password:</label>
        <input type="password" placeholder="New Password" id="forgot" name="password">
        <br/><br/>
        
        <label for="reEnter">Enter the Pass again:</label>
        <input type="password" placeholder="recheck Password" id="reEnter" name="rePAss">
        <br/><br/>
       <input type="submit" placeholder="Reset" name="reset">
       
             </form>
    
    <% } %>
    </div>
</body>
</html>